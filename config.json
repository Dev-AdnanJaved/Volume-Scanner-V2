{
  "binance": {
    "api_key": "",
    "api_secret": ""
  },
  "telegram": {
    "bot_token": "YOUR_BOT_TOKEN",
    "chat_id": "YOUR_CHAT_ID"
  },
  "scanner": {
    "timeframe": "1h",
    "scan_interval_seconds": 900,
    "breakout_lookback_candles": 24,
    "consecutive_vol_candles": 3,
    "consecutive_vol_min_ratio": 2.0,
    "high_breakout_warning_pct": 5.0,
    "max_price_change_24h_pct": 20.0,
    "min_volume_usdt": 0,
    "cooldown_hours": 168,
    "excluded_symbols": ["USDCUSDT", "BTCDOMUSDT"],
    "hard_filters": {
      "vol_ratio_max": 15,
      "funding_rate_min": -0.05,
      "vol_24h_usdt_min": 5000000,
      "market_cap_usd_max": 1000000000
    },
    "soft_flags": {
      "rvol_min": 2.0,
      "market_cap_usd_max": 200000000,
      "oi_growth_ratio_max": 50,
      "funding_rate_min": -0.02,
      "vol_24h_usdt_min": 5000000,
      "price_change_24h_max": 15.0,
      "ema50_distance_pct_max": 15.0,
      "vol_ratio_max": 12.0,
      "max_flags_to_block": 4
    },
    "quality_score": {
      "rvol_sweet_spot_min": 4.0,
      "rvol_sweet_spot_max": 8.0,
      "rvol_adequate_min": 2.0,
      "market_cap_usd_min": 10000000,
      "market_cap_usd_max": 50000000,
      "oi_growth_ratio_min": 5,
      "oi_growth_ratio_max": 50,
      "funding_rate_min": 0,
      "vol_24h_usdt_min": 10000000,
      "breakout_margin_pct_min": 0.5,
      "breakout_margin_pct_max": 5.0,
      "price_change_24h_min": 0,
      "price_change_24h_max": 10.0
    },
    "btc_trend": {
      "enabled": true,
      "skip_on_dump": true,
      "dump_threshold_pct": -3.0,
      "pump_threshold_pct": 3.0
    }
  },
  "tracker": {
    "enabled": true,
    "max_age_hours": 168,
    "price_update_interval_seconds": 300,
    "data_dir": "data",
    "take_profit_targets": [5, 10, 20, 30, 50, 75, 100],
    "reversal_alert_enabled": true,
    "min_reversal_peak_pct": 3.0,
    "reversal_drop_from_peak_pct": 5.0,
    "detailed_report_min_age_hours": 168,
    "daily_report_hour": 0
  },
  "market_cap": {
    "enabled": true,
    "cache_minutes": 120
  },
  "rate_limit": {
    "binance_delay_ms": 100
  },
  "logging": {
    "level": "INFO",
    "log_file": "scanner.log"
  },
  "monster": {
    "candidate_threshold": 6,
    "report_min_score": 3,
    "score_tiers": {
      "6": {
        "label": "max_size", "margin_multiplier": 1.0,
        "take_profits": [
          {"pct": 50.0,  "qty_pct": 50.0, "move_sl_to_breakeven": true},
          {"pct": 100.0, "qty_pct": 50.0, "move_sl_to_breakeven": false}
        ]
      },
      "4": {
        "label": "full_size", "margin_multiplier": 0.75,
        "take_profits": [
          {"pct": 20.0, "qty_pct": 50.0, "move_sl_to_breakeven": true},
          {"pct": 30.0, "qty_pct": 50.0, "move_sl_to_breakeven": false}
        ]
      },
      "3": {
        "label": "half_size", "margin_multiplier": 0.5,
        "take_profits": [
          {"pct": 10.0, "qty_pct": 100.0, "move_sl_to_breakeven": false}
        ]
      }
    },
    "tp5_hold_hours_max": 20,
    "tp5_ema_dist_min": 15.0,
    "tp5_momentum_min": 4.0,
    "tp5_oi_change_min": 12.0,
    "tp5_exit_hours_min": 40,
    "tp5_exit_momentum_max": 2.0,
    "tp5_exit_funding_max": -0.01,
    "tp10_hold_hours_max": 30,
    "tp10_hold_ema_dist_min": 20.0,
    "tp10_hold_oi_min": 18.0,
    "tp10_hold_mcap_max": 100000000,
    "tp10_exit_hours_min": 50,
    "tp10_exit_mcap_max": 150000000,
    "tp10_exit_momentum_max": 2.0
  },
  "auto_trade": {
    "enabled": false,
    "leverage": 20,
    "leverage_fallback_steps": [20, 15, 10, 5],
    "leverage_margin_map": {
      "20": 2.0,
      "15": 2.5,
      "10": 3.0,
      "5": 4.0
    },
    "margin_pct": 2.0,
    "sl_pct": 10.0,
    "move_sl_to_breakeven_after_tp": true,
    "hedge_mode": false,
    "watch_interval_seconds": 30,
    "max_open_trades": 5
  }
}
